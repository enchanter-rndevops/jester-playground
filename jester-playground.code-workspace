{
  "folders": [
    {
      "name": "AWS",
      "path": "aws",
    },
    {
      "path": "frontend",
    },
    {
      "path": "backend",
    },
    {
      "name": "Flyway",
      "path": "flyway",
    },
    {
      "name": "e2e",
      "path": "e2e",
    },
    {
      "name": "Jester-Playground ROOT",
      "path": ".",
    },
  ],
  "settings": {
    "java.compile.nullAnalysis.mode": "disabled",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "always",
      "source.organizeImports": "always",
    },
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.import.maven.disableTestClasspathFlag": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "[java]": {
      "editor.defaultFormatter": "redhat.java",
      "editor.tabSize": 4,
      "editor.insertSpaces": true,
      "editor.detectIndentation": false,
    },
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[xml]": {
      "editor.defaultFormatter": "redhat.vscode-xml",
      "editor.insertSpaces": true,
      "editor.tabSize": 2,
    },
    "xml.format.preserveEmptyContent": false,
    "files.associations": {
      ".code-workspace": "jsonc",
      //      "*.css": "tailwindcss",
    },
    "[jsonc]": {
      "editor.tabSize": 2,
      "editor.insertSpaces": true,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "java.completion.importOrder": ["java", "javax", "org", "com"],
    // プラグインがないと警告が出る。
    // 警告が出たら、プラグインをインストールすること。
    // npm install -g prettier prettier-plugin-tailwindcss
    "prettier.requireConfig": true,
    "editor.scrollbar.horizontalScrollbarSize": 12,
    "editor.scrollbar.verticalScrollbarSize": 14,

    // 標準のCSSリンターによる `@theme` や `@utility` などの警告を無視する
    "css.lint.unknownAtRules": "ignore",

    // SCSSやLessを使っている場合は以下も追加
    "scss.lint.unknownAtRules": "ignore",
    "css.lint.argumentsInColorFunction": "error",
    "java.debug.settings.hotCodeReplace": "auto",
    "java.jdt.ls.javac.enabled": "on",
    "outline.showNull": false,
    "notebook.defaultFormatter": "esbenp.prettier-vscode",
    "java.format.settings.profile": "google",
    "java.format.settings.url": "eclipse-java-google-style.xml",
    "java.debug.settings.onBuildFailureProceed": true,

    // "hediet.vscode-drawio.resizeImages": false,
  },
  "extensions": {
    "recommendations": [
      "bradlc.vscode-tailwindcss",
      "hediet.vscode-drawio",
      "GitHub.codespaces",
      "ms-edgedevtools.vscode-edge-devtools",
      "vscjava.vscode-java-debug",
      "MS-CEINTL.vscode-language-pack-ja",
      "shd101wyy.markdown-preview-enhanced",
      "redhat.java",
      "ms-playwright.playwright",
      "redhat.vscode-xml",
      "esbenp.prettier-vscode",
      "ms-azuretools.vscode-docker",
    ],
  },
}
