<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN" "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">

<!--
MyBatis Generator 設定ファイル。
現在は backendしか存在しないため、ここで生成する
。
Lambdaなどの別なプロジェクトで自動生成したものを使用するときに、
LambdaプロジェクトでもMyBatis Generatorを実行するのはめんどくさいので、backendプロジェクトで生成したものをLambdaプロジェクトにコピーして使用する。
というのもめんどくさいので、MyBatis Generatorをdb-generatorプロジェクトで実行し、mavenリポジトリに配置する。
backend, Lambdaはこれを依存関係で追加する。

ローカルリポジトリでもいいけど、AWS CodeArtifactに配置して、backend, Lambdaはこれを依存関係で追加する。
-->

<generatorConfiguration>

  <!-- DynamicSql 用のランタイム -->
  <context id="MyBatis3DynamicSqlContext"
    targetRuntime="MyBatis3DynamicSql"
    defaultModelType="flat">

    <plugin type="com.softwareloop.mybatis.generator.plugins.LombokPlugin">
      <property name="allArgsConstructor" value="true" />
    </plugin>

    <!--
    <jdbcConnection
      driverClass="${jdbc.DriverClass}"
      connectionURL="${jdbc.Url}"
      userId="${jdbc.Username}"
      password="${jdbc.Password}" />
    -->
    <jdbcConnection
      driverClass="com.mysql.cj.jdbc.Driver"
      connectionURL="jdbc:mysql://localhost:3306/jester"
      userId="jester"
      password="jester" />

    <!-- Entity（モデル）生成 -->
    <modelGenerator
      targetPackage="one.enchanter.rndevops.jester.playground.backend.domain.generated.entity"
      targetProject="src/main/java">
      <!-- <property name="constructorBased" value="true" /> -->
      <!-- <property name="immutable" value="false" /> -->
    </modelGenerator>
    <clientGenerator
      type="ANNOTATEDMAPPER"
      targetPackage="one.enchanter.rndevops.jester.playground.backend.domain.generated.mapper"
      targetProject="src/main/java" />

    <table tableName="users" domainObjectName="UsersEntity" mapperName="UsersMapper" />
    <table tableName="sessions" domainObjectName="SessionsEntity" mapperName="SessionsMapper" />
    <table tableName="items" domainObjectName="ItemsEntity" mapperName="ItemsMapper" />

  </context>
</generatorConfiguration>